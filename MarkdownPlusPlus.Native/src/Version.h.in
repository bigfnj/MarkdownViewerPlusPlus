#ifndef MARKDOWNPLUSPLUS_VERSION_H
#define MARKDOWNPLUSPLUS_VERSION_H

// GENERATED by CMake from Version.h.in. Do not edit the generated copy.
//
// Change the version in ONE place: `project(... VERSION x.y.z)` in the top-level
// CMakeLists.txt. Everything that states a version reads it from here -- the DLL's
// VERSIONINFO resource and the About dialog -- so they cannot drift apart again.
//
// They had drifted: CMakeLists said 1.2.0 while MarkdownPlusPlus.rc said 1,1,0,0 and
// the About box said 1.1.0, so a 1.2.0 build would have reported itself as 1.1.0 to
// both Explorer and the user. The release workflow only compares the tag against
// CMakeLists, so nothing caught it.
//
// Include guards rather than `#pragma once`: this header is also read by the resource
// compiler, whose preprocessor is not the C++ one.

#define MDPP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MDPP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MDPP_VERSION_PATCH @PROJECT_VERSION_PATCH@

// VERSIONINFO wants a comma-separated quad; the string fields want dotted text.
#define MDPP_VERSION_COMMA @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define MDPP_VERSION_STRING "@PROJECT_VERSION@"
#define MDPP_VERSION_STRING_FULL "@PROJECT_VERSION@.0"

// The About dialog builds a wide literal, so the narrow macro needs widening through
// one level of indirection (the argument must expand before the L is pasted on).
#define MDPP_WIDEN_IMPL(text) L##text
#define MDPP_WIDEN(text) MDPP_WIDEN_IMPL(text)
#define MDPP_VERSION_WSTRING MDPP_WIDEN(MDPP_VERSION_STRING)

#endif  // MARKDOWNPLUSPLUS_VERSION_H
