#include "resource.h"
#include "Version.h"
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDPP_VERSION_COMMA
 PRODUCTVERSION MDPP_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Markdown++"
            VALUE "FileDescription", "Markdown++ native Notepad++ plugin"
            VALUE "FileVersion", MDPP_VERSION_STRING_FULL
            VALUE "InternalName", "MarkdownPlusPlus"
            VALUE "OriginalFilename", "MarkdownPlusPlus.dll"
            VALUE "ProductName", "Markdown++"
            VALUE "ProductVersion", MDPP_VERSION_STRING_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
